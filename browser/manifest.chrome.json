{
  "manifest_version": 3,
  "name": "Egress Guard Companion",
  "version": "0.2.0",
  "description": "Blocks ads, trackers and malware with locally built lists, strips tracking parameters, and adds per-site rules. No remote code or extension networking.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "declarative_net_request": {
    "rule_resources": [
      {"id": "threats", "enabled": true, "path": "rules/threats.json"},
      {"id": "trackers", "enabled": true, "path": "rules/trackers.json"},
      {"id": "cname", "enabled": true, "path": "rules/cname.json"},
      {"id": "params", "enabled": true, "path": "rules/params.json"}
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core/selectors.js", "core/picker.js", "core/cosmetic.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [{"resources": ["warning.html"], "matches": ["<all_urls>"], "use_dynamic_url": true}],
  "action": {"default_title": "Egress Guard", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; frame-ancestors 'none'"}
}
