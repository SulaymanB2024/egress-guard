{
  "manifest_version": 3,
  "name": "Egress Guard Companion",
  "version": "0.12.0",
  "description": "Locally built ad, tracker and threat blocking, with reversible page hiding and optional on-device ad review.",
  "key": "",
  "minimum_chrome_version": "145",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "cookies",
    "contextMenus",
    "offscreen",
    "clipboardWrite",
    "scripting",
    "webNavigation",
    "browsingData"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": []
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-gpc.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "core/psl-data.js",
        "core/hosts.js",
        "core/selectors.js",
        "core/picker.js",
        "core/cosmetic-data.js",
        "core/cosmetic-selectors.js",
        "core/cosmetic.js",
        "core/semantic.js",
        "content.js",
        "core/links.js",
        "core/param-data.js",
        "core/param-policy.js",
        "core/params.js",
        "page-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "unwrap.html",
        "surrogates/*.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "action": {
    "default_title": "Egress Guard",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; frame-ancestors 'none'"
  },
  "optional_permissions": [
    "nativeMessaging",
    "privacy"
  ]
}
