{
  "manifest_version": 3,
  "name": "Egress Guard Companion",
  "version": "0.3.1",
  "description": "Blocks ads, trackers and malware with locally built lists, strips tracking parameters, and adds per-site rules. No remote code or extension networking.",
  "key": "",
  "minimum_chrome_version": "128",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "alarms", "cookies", "contextMenus", "offscreen", "clipboardWrite", "scripting", "browsingData"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "declarative_net_request": {
    "rule_resources": []
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-gpc.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["core/selectors.js", "core/picker.js", "core/cosmetic.js", "content.js", "core/links.js", "core/params.js", "page-guard.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [{"resources": ["warning.html", "unwrap.html", "surrogates/*.js"], "matches": ["<all_urls>"], "use_dynamic_url": true}],
  "action": {"default_title": "Egress Guard", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; frame-ancestors 'none'"}
}
